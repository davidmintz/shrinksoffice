{# templates/person/_form.html.twig #}

{% import 'macros/alert.html.twig' as alerts %}
{#  later, maybe data-controller="entity-form" #}
<div data-controller="person"
     data-person-entity-type-value="{{ entity_type }}"
     data-person-verbiage-value="{{ verbiage }}">

    {{ alerts.xhr_status('status', 'alert-success') }}

<form class="me-3" name="person" action="/people/add" id="person-form" method="post" data-turbo="false" novalidate
      data-action="submit->person#submit"
      data-person-target="form"
>
    {% set subset_fields = ['firstname', 'middlename', 'lastname', 'alias', 'email', 'phone',
        'address','secondary_address', ] %}
        {% for row in subset_fields|batch(2) %}
            <div class="row mb-3">
                {% for field_name in row %}
                    {% if attribute(form, field_name) is defined %}
                        <label for="{{ form[field_name].vars.id }}" class="text-md-end col-sm-2 col-form-label">
                            {{ form[field_name].vars.label|default(field_name) }}
                        </label>
                        <div class="col-sm-4">
                            {{ form_widget(form[field_name], {'attr': {'class': 'form-control' ~ (form_errors(form[field_name]) ? ' is-invalid' : '') }}) }}
                            <div class="invalid-feedback">{{ form_errors(form[field_name]) }}</div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endfor %}
        <div class="row mb-3">
            <label for="{{ form.city.vars.id }}" class="text-md-end col-sm-2 col-form-label">city</label>
            <div class="col-sm-3">
                {{ form_widget(form.city, {'attr': {'class': 'form-control' ~ (form_errors(form.city) ? ' is-invalid' : '') }}) }}
                <div class="invalid-feedback">{{ form_errors(form.city) }}</div>
            </div>

            <label for="{{ form.state.vars.id }}" class="text-md-end col-sm-1 col-form-label">state</label>
            <div class="col-sm-2">
                {{ form_widget(form.state, { 'attr': {'style': 'width: 7ch', 'class': 'form-control' ~ (form_errors(form.city) ? ' is-invalid' : '')} }) }}
                <div class="invalid-feedback">{{ form_errors(form.state) }}</div>
            </div>

            <label for="{{ form.postal_code.vars.id }}" class="text-md-end col-sm-1 col-form-label">zip</label>
            <div class="col-sm-3">
                {{ form_widget(form.postal_code, {'attr': {'class': 'form-control' ~ (form_errors(form.postal_code) ? ' is-invalid' : '') }}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.postal_code) }}
                </div>
            </div>
        </div>
        <div class="row mb-3">
            <label for="{{ form.payer.vars.id }}" class="text-md-end col-sm-2 col-form-label">
                payer
            </label>
            <div class="col-sm-4 position-relative">
                {{ form_widget(form.payer, {'attr': {'class':'form-select'}}) }}
            </div>
            <label for="{{ form.fee.vars.id }}" class="text-md-end col-sm-2 col-form-label">
                fee
            </label>
            <div class="col-sm-4 position-relative">
                {{ form_widget(form.fee, {'attr': {'class':'form-control','style': 'width: 8ch' }}) }}
            </div>
        </div>
        <div class="row mb-3"><!-- new shit -->
            <div class="col-md-6">
                <!-- Active Field -->
                <fieldset class="form-group row">
                    <legend class="col-sm-4 col-form-label text-md-end">active?</legend>
                    <div class="col-sm-4 d-flex align-items-center">
                        {% set isInvalid = form_errors(form.active) ? ' is-invalid' : '' %}
                        {% set labelStyle = form_errors(form.active) ? 'color: #dc3545;' : '' %}

                        {% for choice in form.active.vars.choices %}
                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       id="active_{{ choice.value }}"
                                       name="{{ form.active.vars.full_name }}"
                                       value="{{ choice.value }}"
                                       {% if form.active.vars.value == choice.value %}checked{% endif %}
                                       class="form-check-input{{ isInvalid }}">

                                <label for="active_{{ choice.value }}" class="form-check-label" style="{{ labelStyle }}">
                                    {{ choice.label }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                </fieldset>
                <div class="col-sm-8 offset-sm-4">
                    <div  style="font-size:0.9em"  class="invalid-feedback d-block">{{ form_errors(form.active) }}</div>
                </div>
                <!-- "type" (status) field -->
                <fieldset class="form-group row">
                    <legend class="col-sm-4 col-form-label text-md-end">status</legend>
                    <div class="col-sm-8 d-flex align-items-center">
                        {% for choice in form.type.vars.choices %}
                            <div class="form-check form-check-inline">
                                <input type="radio"
                                       id="type_{{ choice.value }}"
                                       name="{{ form.type.vars.full_name }}"
                                       value="{{ choice.value }}"
                                       {% if form.type.vars.value == choice.value %}checked{% endif %}
                                       class="form-check-input{% if form_errors(form.type) %} is-invalid{% endif %}">
                                <label for="type_{{ choice.value }}" class="form-check-label">
                                    {% if choice.value == 'patient' %}
                                        patient
                                    {% elseif choice.value == 'payer' %}
                                        payer only
                                    {% else %}
                                        {{ choice.label }}
                                    {% endif %}
                                </label>
                            </div>

                        {% endfor %}
                    </div>
                </fieldset>
                <div class="col-sm-8 offset-sm-4">
                    <div  style="font-size:0.9em"  class="invalid-feedback d-block">{{ form_errors(form.type) }}</div>
                </div>
            </div>
            <!-- Right Column -->
            <div class="col-md-6">
                <!-- Notes Field -->
                <div class="form-group row">
                    <label for="notes" class="col-sm-4 col-form-label text-md-end">notes</label>
                    <div class="col-sm-8">
                        <textarea id="notes" name="person[notes]" class="form-control" rows="5"></textarea>
                    </div>
                </div>
            </div>
        </div><!-- /new shit -->
        <div class="row mb-3">
            <div class="d-flex justify-content-center">
                {{ form_widget(form._token) }}
                <div class="invalid-feedback">
                {{ form_errors(form._token) }}
                </div>
            </div>
        </div>
        <div class="row mb-3">
            <div class="d-flex justify-content-center">
                <button class="btn btn-primary btn-lg">Save</button>
            </div>
        </div>
    </form>
</div>

